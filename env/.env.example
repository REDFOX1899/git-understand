# =============================================================================
# GitUnderstand Master Environment Configuration (env/.env.example)
# Domain: https://git-understand.com  |  API: https://api.git-understand.com
# =============================================================================
# INSTRUCTIONS:
#   1. Copy this file to: env/.env   (gitignored — NEVER commit env/.env!)
#   2. Add your Gemini API key(s) below (users can also supply BYOK keys in-app).
# =============================================================================

# -----------------------------------------------------------------------------
# 1. GEMINI 4 API KEYS (Primary + Optional Secondary for Dual-Key Sharding)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_API_KEY_SECONDARY=

# -----------------------------------------------------------------------------
# 2. MODEL ROUTING (Gemini 4 Family + Decisions + Live + Multimodal Media)
# -----------------------------------------------------------------------------
GEMINI_MODEL_ARCHITECT=gemini-4-carbon
GEMINI_MODEL_VISUAL=gemini-4-neon
GEMINI_MODEL_FAST=gemini-4-argon
GEMINI_MODEL_ORACLE=gemini-4-hydrogen
GEMINI_MODEL_LITE=gemini-3.5-flash-lite
GEMINI_MODEL_DECISIONS=gemini-decision-1
GEMINI_MODEL_LIVE=gemini-3.8-live
GEMINI_MODEL_LIVE_THINKING=gemini-3.8-live-extended-thinking
GEMINI_MODEL_IMAGE=gemini-nano-banana-2.1
GEMINI_MODEL_TTS=gemini-3.8-flash-tts
GEMINI_MODEL_VIDEO=gemini-omni-1.2-flash
GEMINI_MODEL_EMBEDDING=gemini-embedding-2
GEMINI_MODEL_TRANSCRIBE=gemini-3.5-transcribe
GEMINI_MANAGED_AGENT=antigravity-preview-09-2026
GEMINI_DEEP_RESEARCH=deep-research-preview-04-2026

# -----------------------------------------------------------------------------
# 3. RUNTIME PORTS & PUBLIC URLS
# -----------------------------------------------------------------------------
BACKEND_PORT=4000
STUDIO_PORT=3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,https://git-understand.com,https://www.git-understand.com

# -----------------------------------------------------------------------------
# 4. GITHUB INTEGRATION (Optional — raises rate limit & enables private repos)
# -----------------------------------------------------------------------------
GITHUB_TOKEN=

# -----------------------------------------------------------------------------
# 5. GOOGLE CLOUD DEPLOYMENT (Cloud Run — api.git-understand.com)
# -----------------------------------------------------------------------------
GCP_PROJECT_ID=gitunderstand
GCP_REGION=us-central1
CLOUD_RUN_SERVICE=git-understand-engine
